{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["nodes"],
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "temp_id",
          "name",
          "type",
          "role",
          "definition",
          "origin",
          "confidence",
          "optional",
          "is_root_candidate",
          "evidence",
          "support_unit_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "temp_id": { "type": "string" },
          "name": { "type": "string", "minLength": 2 },
          "type": { "type": "string" },
          "role": { "type": "string" },
          "definition": { "type": "string" },
          "origin": {
            "enum": ["explicit", "abstractive", "structural"]
          },
          "branch_id": { "type": ["string", "null"] },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "optional": { "type": "boolean" },
          "activation_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "activation_cost": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "is_root_candidate": { "const": false },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chunk_id", "excerpt"],
              "additionalProperties": false,
              "properties": {
                "chunk_id": { "type": "string" },
                "excerpt": { "type": "string" },
                "page": { "type": ["integer", "null"] },
                "slide": { "type": ["integer", "null"] }
              }
            }
          },
          "support_unit_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "media_asset_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
