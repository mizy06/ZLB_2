{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "HumanMustHaveRef": {
      "additionalProperties": false,
      "properties": {
        "human_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "rationale": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "human_ref",
        "source_ids",
        "rationale"
      ],
      "title": "HumanMustHaveRef",
      "type": "object"
    },
    "InventoryEntry": {
      "additionalProperties": false,
      "properties": {
        "declared_role": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Role"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "importance": {
          "$ref": "#/$defs/InventoryImportance",
          "default": "normal"
        },
        "inspection_status": {
          "$ref": "#/$defs/InventoryInspectionStatus",
          "default": "must_inspect"
        },
        "inventory_entry_id": {
          "pattern": "^inventory_entry_[0-9a-f]{32}$",
          "title": "Inventory Entry Id",
          "type": "string"
        },
        "page_id": {
          "anyOf": [
            {
              "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Id"
        },
        "source_id": {
          "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/InventoryEntryKind"
        }
      },
      "required": [
        "inventory_entry_id",
        "source_id",
        "source_kind",
        "evidence_refs"
      ],
      "title": "InventoryEntry",
      "type": "object"
    },
    "InventoryEntryKind": {
      "enum": [
        "page",
        "block",
        "table_cell",
        "formula_region",
        "reaction_region",
        "visual_region",
        "outline",
        "unresolved"
      ],
      "title": "InventoryEntryKind",
      "type": "string"
    },
    "InventoryImportance": {
      "enum": [
        "low",
        "normal",
        "high",
        "must_have"
      ],
      "title": "InventoryImportance",
      "type": "string"
    },
    "InventoryInspectionStatus": {
      "enum": [
        "must_inspect",
        "unresolved",
        "human_must_have"
      ],
      "title": "InventoryInspectionStatus",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:source-inventory:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "block_entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InventoryEntry"
      },
      "title": "Block Entries",
      "type": "array"
    },
    "document_ir_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "formula_region_entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InventoryEntry"
      },
      "title": "Formula Region Entries",
      "type": "array"
    },
    "human_must_have_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HumanMustHaveRef"
      },
      "title": "Human Must Have Refs",
      "type": "array"
    },
    "inventory_id": {
      "pattern": "^inventory_[0-9a-f]{32}$",
      "title": "Inventory Id",
      "type": "string"
    },
    "inventory_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Inventory Policy Version",
      "type": "string"
    },
    "outline_entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InventoryEntry"
      },
      "title": "Outline Entries",
      "type": "array"
    },
    "page_entries": {
      "items": {
        "$ref": "#/$defs/InventoryEntry"
      },
      "title": "Page Entries",
      "type": "array"
    },
    "reaction_region_entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InventoryEntry"
      },
      "title": "Reaction Region Entries",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "table_cell_entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InventoryEntry"
      },
      "title": "Table Cell Entries",
      "type": "array"
    },
    "unresolved_entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InventoryEntry"
      },
      "title": "Unresolved Entries",
      "type": "array"
    },
    "visual_region_entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InventoryEntry"
      },
      "title": "Visual Region Entries",
      "type": "array"
    }
  },
  "required": [
    "inventory_id",
    "document_ir_ref",
    "page_entries",
    "inventory_policy_version"
  ],
  "title": "SourceInventory",
  "type": "object"
}
