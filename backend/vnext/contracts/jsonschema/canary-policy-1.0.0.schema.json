{
  "$defs": {
    "CanaryStage": {
      "enum": [
        "shadow",
        "allowlist",
        "percent_1",
        "percent_5",
        "percent_20",
        "percent_50",
        "default"
      ],
      "title": "CanaryStage",
      "type": "string"
    },
    "CanaryStageRule": {
      "additionalProperties": false,
      "properties": {
        "minimum_cumulative_samples": {
          "minimum": 0,
          "title": "Minimum Cumulative Samples",
          "type": "integer"
        },
        "next_stage": {
          "$ref": "#/$defs/CanaryStage"
        },
        "stage": {
          "$ref": "#/$defs/CanaryStage"
        },
        "traffic_percent": {
          "maximum": 100,
          "minimum": 0,
          "title": "Traffic Percent",
          "type": "integer"
        }
      },
      "required": [
        "stage",
        "next_stage",
        "traffic_percent",
        "minimum_cumulative_samples"
      ],
      "title": "CanaryStageRule",
      "type": "object"
    }
  },
  "$id": "urn:zlb:vnext:schema:canary-policy:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "require_blind_set_expansion": {
      "default": true,
      "title": "Require Blind Set Expansion",
      "type": "boolean"
    },
    "require_diagnostic_ux": {
      "default": true,
      "title": "Require Diagnostic Ux",
      "type": "boolean"
    },
    "require_disaster_recovery_for_default": {
      "default": true,
      "title": "Require Disaster Recovery For Default",
      "type": "boolean"
    },
    "require_pilot_pass": {
      "default": true,
      "title": "Require Pilot Pass",
      "type": "boolean"
    },
    "require_public_api_approval": {
      "default": true,
      "title": "Require Public Api Approval",
      "type": "boolean"
    },
    "require_rollback_drill": {
      "default": true,
      "title": "Require Rollback Drill",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_rules": {
      "items": {
        "$ref": "#/$defs/CanaryStageRule"
      },
      "title": "Stage Rules",
      "type": "array"
    }
  },
  "required": [
    "policy_version",
    "stage_rules"
  ],
  "title": "CanaryPolicy",
  "type": "object"
}
