{
  "$defs": {
    "ArtifactProducerRef": {
      "additionalProperties": false,
      "properties": {
        "model_revision": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "producer_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Producer Version",
          "type": "string"
        },
        "prompt_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Digest"
        },
        "role": {
          "$ref": "#/$defs/RuntimeRole"
        }
      },
      "required": [
        "producer_id",
        "producer_version",
        "role"
      ],
      "title": "ArtifactProducerRef",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "relation_proposal_ledger",
        "relation_assessment_ledger",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "CanonicalRelation": {
      "additionalProperties": false,
      "properties": {
        "decision_history": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DecisionEvent"
          },
          "title": "Decision History",
          "type": "array"
        },
        "edge_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Edge Evidence Refs",
          "type": "array"
        },
        "evidence_authority": {
          "$ref": "#/$defs/EvidenceAuthority"
        },
        "external_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "External Evidence Refs",
          "type": "array"
        },
        "hierarchy_directness": {
          "$ref": "#/$defs/HierarchyDirectness"
        },
        "region_plan_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rejection_reasons": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Rejection Reasons",
          "type": "array"
        },
        "relation_id": {
          "pattern": "^relation_[0-9a-f]{32}$",
          "title": "Relation Id",
          "type": "string"
        },
        "semantic_relation": {
          "$ref": "#/$defs/SemanticRelation"
        },
        "source_claim_ids": {
          "default": [],
          "items": {
            "pattern": "^claim_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Source Claim Ids",
          "type": "array"
        },
        "source_id": {
          "pattern": "^concept_[0-9a-f]{32}$",
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CanonicalStatus"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^relation_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "target_id": {
          "pattern": "^concept_[0-9a-f]{32}$",
          "title": "Target Id",
          "type": "string"
        },
        "verifier_decisions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VerifierDecision"
          },
          "title": "Verifier Decisions",
          "type": "array"
        }
      },
      "required": [
        "relation_id",
        "source_id",
        "target_id",
        "semantic_relation",
        "hierarchy_directness",
        "evidence_authority",
        "status"
      ],
      "title": "CanonicalRelation",
      "type": "object"
    },
    "CanonicalStatus": {
      "enum": [
        "candidate",
        "accepted",
        "conflicted",
        "abstained",
        "rejected",
        "superseded"
      ],
      "title": "CanonicalStatus",
      "type": "string"
    },
    "DecisionEvent": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeRole"
            },
            {
              "pattern": "^human:[A-Za-z0-9._:@-]{1,128}$",
              "type": "string"
            }
          ],
          "title": "Actor"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decision",
          "type": "string"
        },
        "decision_id": {
          "pattern": "^decision_[0-9a-f]{32}$",
          "title": "Decision Id",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^decision_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        }
      },
      "required": [
        "decision_id",
        "actor",
        "decision",
        "created_at"
      ],
      "title": "DecisionEvent",
      "type": "object"
    },
    "EvidenceAuthority": {
      "enum": [
        "courseware_direct",
        "outline_structural",
        "courseware_aggregate",
        "external_only",
        "retrieval_only"
      ],
      "title": "EvidenceAuthority",
      "type": "string"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "HierarchyDirectness": {
      "enum": [
        "direct",
        "ancestor_only",
        "non_hierarchical",
        "uncertain"
      ],
      "title": "HierarchyDirectness",
      "type": "string"
    },
    "RuntimeRole": {
      "enum": [
        "run_governor",
        "document_interpreter",
        "source_inventory_auditor",
        "global_structure_planner",
        "recursive_region_planner",
        "region_decision_verifier",
        "claim_atomizer",
        "omission_auditor",
        "bottom_up_region_auditor",
        "claim_fidelity_verifier",
        "domain_resolver",
        "relation_proposer",
        "canonicalizer",
        "relation_verifier_a",
        "relation_verifier_b",
        "arbiter",
        "quality_auditor",
        "projection_planner",
        "release_evidence_aggregator",
        "canary_observation_aggregator"
      ],
      "title": "RuntimeRole",
      "type": "string"
    },
    "SemanticRelation": {
      "enum": [
        "topic_contains",
        "is_a",
        "part_of",
        "stage_of",
        "example_of",
        "prerequisite",
        "causes",
        "precedes",
        "contrasts",
        "reacts_with",
        "review_of",
        "depends_on",
        "used_for",
        "condition_for",
        "mechanism_of",
        "transforms_to"
      ],
      "title": "SemanticRelation",
      "type": "string"
    },
    "VerifierClassification": {
      "enum": [
        "direct",
        "ancestor_only",
        "sibling",
        "semantic_link",
        "unrelated",
        "insufficient"
      ],
      "title": "VerifierClassification",
      "type": "string"
    },
    "VerifierDecision": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "$ref": "#/$defs/VerifierClassification"
        },
        "courseware_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Courseware Evidence Refs",
          "type": "array"
        },
        "outline_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Outline Evidence Refs",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "supports_relation": {
          "title": "Supports Relation",
          "type": "boolean"
        },
        "verifier": {
          "$ref": "#/$defs/ArtifactProducerRef"
        }
      },
      "required": [
        "verifier",
        "classification",
        "supports_relation",
        "reason_codes"
      ],
      "title": "VerifierDecision",
      "type": "object"
    }
  },
  "$id": "urn:zlb:vnext:schema:relation-proposal-ledger:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_graph_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Graph Digest",
      "type": "string"
    },
    "owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "proposed_relations": {
      "items": {
        "$ref": "#/$defs/CanonicalRelation"
      },
      "title": "Proposed Relations",
      "type": "array"
    },
    "proposer": {
      "$ref": "#/$defs/ArtifactProducerRef"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "candidate_graph_digest",
    "proposer",
    "policy_digest",
    "proposed_relations"
  ],
  "title": "RelationProposalLedger",
  "type": "object"
}
