{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "RenderedFileKind": {
      "enum": [
        "web_html",
        "png_tile",
        "pdf",
        "json"
      ],
      "title": "RenderedFileKind",
      "type": "string"
    },
    "RenderedMediaFile": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/RenderedFileKind"
        },
        "logical_page_count": {
          "default": 1,
          "minimum": 1,
          "title": "Logical Page Count",
          "type": "integer"
        },
        "media_type": {
          "enum": [
            "text/html",
            "image/png",
            "application/pdf",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "node_ids": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 3,
            "type": "string"
          },
          "title": "Node Ids",
          "type": "array"
        },
        "page_or_tile_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Or Tile Index"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        },
        "pixel_height": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Height"
        },
        "pixel_width": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Width"
        },
        "relative_path": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "semantic_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Semantic Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "relative_path",
        "media_type",
        "payload_digest",
        "byte_size",
        "semantic_fingerprint"
      ],
      "title": "RenderedMediaFile",
      "type": "object"
    }
  },
  "$id": "urn:zlb:vnext:schema:rendered-presentation-bundle:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_graph_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/RenderedMediaFile"
      },
      "minItems": 4,
      "title": "Files",
      "type": "array"
    },
    "font_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Font Digest",
      "type": "string"
    },
    "font_family": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Font Family",
      "type": "string"
    },
    "media_bundle_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Media Bundle Digest",
      "type": "string"
    },
    "media_bundle_id": {
      "pattern": "^media_bundle_[0-9a-f]{32}$",
      "title": "Media Bundle Id",
      "type": "string"
    },
    "owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "projection_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "publication_enabled": {
      "const": false,
      "default": false,
      "title": "Publication Enabled",
      "type": "boolean"
    },
    "render_bundle_id": {
      "pattern": "^render_bundle_[0-9a-f]{32}$",
      "title": "Render Bundle Id",
      "type": "string"
    },
    "renderer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Renderer Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Semantic Fingerprint",
      "type": "string"
    },
    "semantic_node_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 3,
        "type": "string"
      },
      "title": "Semantic Node Ids",
      "type": "array"
    }
  },
  "required": [
    "render_bundle_id",
    "owner_id",
    "media_bundle_id",
    "media_bundle_digest",
    "canonical_graph_ref",
    "projection_ref",
    "semantic_fingerprint",
    "semantic_node_ids",
    "renderer_version",
    "font_family",
    "font_digest",
    "files",
    "created_at"
  ],
  "title": "RenderedPresentationBundle",
  "type": "object"
}
