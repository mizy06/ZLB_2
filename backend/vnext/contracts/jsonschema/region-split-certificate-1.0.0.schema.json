{
  "$defs": {
    "ArtifactProducerRef": {
      "additionalProperties": false,
      "properties": {
        "model_revision": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "producer_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Producer Version",
          "type": "string"
        },
        "prompt_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Digest"
        },
        "role": {
          "$ref": "#/$defs/RuntimeRole"
        }
      },
      "required": [
        "producer_id",
        "producer_version",
        "role"
      ],
      "title": "ArtifactProducerRef",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "GateAssessment": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "passed",
        "rationale"
      ],
      "title": "GateAssessment",
      "type": "object"
    },
    "RegionChildLabel": {
      "additionalProperties": false,
      "properties": {
        "child_region_id": {
          "pattern": "^reg_[0-9a-f]{32}$",
          "title": "Child Region Id",
          "type": "string"
        },
        "has_independent_source_support": {
          "title": "Has Independent Source Support",
          "type": "boolean"
        },
        "label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "label_self_contained": {
          "title": "Label Self Contained",
          "type": "boolean"
        },
        "source_support_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Source Support Refs",
          "type": "array"
        }
      },
      "required": [
        "child_region_id",
        "label",
        "label_self_contained",
        "has_independent_source_support",
        "source_support_refs"
      ],
      "title": "RegionChildLabel",
      "type": "object"
    },
    "RegionSourceAssignment": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "$ref": "#/$defs/SourceAssignmentDisposition"
        },
        "rationale": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "region_ids": {
          "default": [],
          "items": {
            "pattern": "^reg_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Region Ids",
          "type": "array"
        },
        "source_id": {
          "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "disposition",
        "rationale"
      ],
      "title": "RegionSourceAssignment",
      "type": "object"
    },
    "RuntimeRole": {
      "enum": [
        "run_governor",
        "document_interpreter",
        "source_inventory_auditor",
        "global_structure_planner",
        "recursive_region_planner",
        "region_decision_verifier",
        "claim_atomizer",
        "omission_auditor",
        "bottom_up_region_auditor",
        "claim_fidelity_verifier",
        "domain_resolver",
        "canonicalizer",
        "relation_verifier_a",
        "relation_verifier_b",
        "arbiter",
        "quality_auditor",
        "projection_planner"
      ],
      "title": "RuntimeRole",
      "type": "string"
    },
    "SourceAssignmentDisposition": {
      "enum": [
        "primary_region",
        "secondary_cross_cutting",
        "explicitly_nonclaim",
        "unresolved"
      ],
      "title": "SourceAssignmentDisposition",
      "type": "string"
    },
    "SplitDecision": {
      "enum": [
        "ACCEPT_SPLIT",
        "REJECT_SPLIT",
        "UNRESOLVED"
      ],
      "title": "SplitDecision",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:region-split-certificate:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "boundaries_explainable": {
      "title": "Boundaries Explainable",
      "type": "boolean"
    },
    "boundary_evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Boundary Evidence",
      "type": "array"
    },
    "child_labels": {
      "items": {
        "$ref": "#/$defs/RegionChildLabel"
      },
      "title": "Child Labels",
      "type": "array"
    },
    "child_region_ids": {
      "items": {
        "pattern": "^reg_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Child Region Ids",
      "type": "array"
    },
    "cross_cutting_source_ids": {
      "default": [],
      "items": {
        "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Cross Cutting Source Ids",
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/SplitDecision"
    },
    "inventory_reconciled": {
      "title": "Inventory Reconciled",
      "type": "boolean"
    },
    "parent_common_concept": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Parent Common Concept",
      "type": "string"
    },
    "parent_common_concept_supported": {
      "title": "Parent Common Concept Supported",
      "type": "boolean"
    },
    "parent_region_id": {
      "pattern": "^reg_[0-9a-f]{32}$",
      "title": "Parent Region Id",
      "type": "string"
    },
    "residual_source_ids": {
      "default": [],
      "items": {
        "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Residual Source Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sibling_granularity_comparable": {
      "title": "Sibling Granularity Comparable",
      "type": "boolean"
    },
    "sibling_separation": {
      "$ref": "#/$defs/GateAssessment"
    },
    "source_assignment_map": {
      "items": {
        "$ref": "#/$defs/RegionSourceAssignment"
      },
      "title": "Source Assignment Map",
      "type": "array"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "uses_capacity_as_semantic_evidence": {
      "default": false,
      "title": "Uses Capacity As Semantic Evidence",
      "type": "boolean"
    },
    "verifier": {
      "$ref": "#/$defs/ArtifactProducerRef"
    },
    "within_region_cohesion": {
      "$ref": "#/$defs/GateAssessment"
    }
  },
  "required": [
    "parent_region_id",
    "parent_common_concept",
    "parent_common_concept_supported",
    "child_region_ids",
    "child_labels",
    "source_assignment_map",
    "boundary_evidence",
    "sibling_separation",
    "within_region_cohesion",
    "sibling_granularity_comparable",
    "boundaries_explainable",
    "inventory_reconciled",
    "decision",
    "verifier"
  ],
  "title": "RegionSplitCertificate",
  "type": "object"
}
