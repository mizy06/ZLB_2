{
  "$defs": {
    "ClaimProposal": {
      "additionalProperties": false,
      "properties": {
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "instructional_role": {
          "$ref": "#/$defs/InstructionalRole"
        },
        "predicate": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "source_id": {
          "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_quote": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Source Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_quote",
        "claim_type",
        "instructional_role",
        "predicate"
      ],
      "title": "ClaimProposal",
      "type": "object"
    },
    "ClaimType": {
      "enum": [
        "definition",
        "property",
        "mechanism",
        "reaction",
        "condition",
        "comparison",
        "example",
        "exception",
        "procedure",
        "warning",
        "summary",
        "instruction",
        "structural_fact"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "InstructionalRole": {
      "enum": [
        "definition",
        "principle",
        "procedure",
        "comparison",
        "application",
        "exercise",
        "review",
        "example",
        "warning",
        "other"
      ],
      "title": "InstructionalRole",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:claim-proposal-batch:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "proposals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ClaimProposal"
      },
      "maxItems": 256,
      "title": "Proposals",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unresolved_source_ids": {
      "default": [],
      "items": {
        "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Unresolved Source Ids",
      "type": "array"
    }
  },
  "title": "ClaimProposalBatch",
  "type": "object"
}
