{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "DataClassification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidencePurpose": {
      "enum": [
        "disambiguate",
        "normalize",
        "conflict_check",
        "extend"
      ],
      "title": "EvidencePurpose",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "RuntimeRole": {
      "enum": [
        "run_governor",
        "document_interpreter",
        "source_inventory_auditor",
        "global_structure_planner",
        "recursive_region_planner",
        "region_decision_verifier",
        "claim_atomizer",
        "omission_auditor",
        "bottom_up_region_auditor",
        "claim_fidelity_verifier",
        "domain_resolver",
        "canonicalizer",
        "relation_verifier_a",
        "relation_verifier_b",
        "arbiter",
        "quality_auditor",
        "projection_planner"
      ],
      "title": "RuntimeRole",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:search-intent:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_role": {
      "$ref": "#/$defs/RuntimeRole"
    },
    "allowed_domains": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Allowed Domains",
      "type": "array"
    },
    "blocked_domains": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Blocked Domains",
      "type": "array"
    },
    "data_classification": {
      "$ref": "#/$defs/DataClassification"
    },
    "evidence_purpose": {
      "$ref": "#/$defs/EvidencePurpose"
    },
    "freshness_hours": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freshness Hours"
    },
    "intent_id": {
      "pattern": "^search_intent_[0-9a-f]{32}$",
      "title": "Intent Id",
      "type": "string"
    },
    "max_fetches": {
      "maximum": 72,
      "minimum": 1,
      "title": "Max Fetches",
      "type": "integer"
    },
    "max_queries": {
      "maximum": 36,
      "minimum": 1,
      "title": "Max Queries",
      "type": "integer"
    },
    "owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "query_candidates": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Query Candidates",
      "type": "array"
    },
    "question": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "redaction_policy": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Redaction Policy",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_priority": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Source Priority",
      "type": "array"
    },
    "tenant_consent_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trigger_code": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Trigger Code",
      "type": "string"
    }
  },
  "required": [
    "intent_id",
    "run_id",
    "owner_id",
    "agent_role",
    "question",
    "query_candidates",
    "evidence_purpose",
    "trigger_code",
    "data_classification",
    "redaction_policy",
    "max_queries",
    "max_fetches"
  ],
  "title": "SearchIntent",
  "type": "object"
}
