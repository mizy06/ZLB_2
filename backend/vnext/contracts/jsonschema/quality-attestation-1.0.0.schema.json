{
  "$defs": {
    "ArtifactProducerRef": {
      "additionalProperties": false,
      "properties": {
        "model_revision": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "producer_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Producer Version",
          "type": "string"
        },
        "prompt_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Digest"
        },
        "role": {
          "$ref": "#/$defs/RuntimeRole"
        }
      },
      "required": [
        "producer_id",
        "producer_version",
        "role"
      ],
      "title": "ArtifactProducerRef",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "relation_proposal_ledger",
        "relation_assessment_ledger",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "QualityGateDecision": {
      "enum": [
        "pass",
        "block",
        "incomplete",
        "review"
      ],
      "title": "QualityGateDecision",
      "type": "string"
    },
    "QualityMetric": {
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "default": true,
          "title": "Applicable",
          "type": "boolean"
        },
        "hard": {
          "default": true,
          "title": "Hard",
          "type": "boolean"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "QualityMetric",
      "type": "object"
    },
    "RuntimeRole": {
      "enum": [
        "run_governor",
        "document_interpreter",
        "source_inventory_auditor",
        "global_structure_planner",
        "recursive_region_planner",
        "region_decision_verifier",
        "claim_atomizer",
        "omission_auditor",
        "bottom_up_region_auditor",
        "claim_fidelity_verifier",
        "domain_resolver",
        "relation_proposer",
        "canonicalizer",
        "relation_verifier_a",
        "relation_verifier_b",
        "arbiter",
        "quality_auditor",
        "projection_planner",
        "release_evidence_aggregator",
        "canary_observation_aggregator"
      ],
      "title": "RuntimeRole",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:quality-attestation:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "attestation_id": {
      "pattern": "^attestation_[0-9a-f]{32}$",
      "title": "Attestation Id",
      "type": "string"
    },
    "closure_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Closure Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evaluator": {
      "$ref": "#/$defs/ArtifactProducerRef"
    },
    "evaluator_build_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evaluator Build Digest",
      "type": "string"
    },
    "gate_decision": {
      "$ref": "#/$defs/QualityGateDecision"
    },
    "incomplete_items": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Incomplete Items",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/QualityMetric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "review_items": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Review Items",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "pattern": "^attestation_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    }
  },
  "required": [
    "attestation_id",
    "owner_id",
    "artifact_ref",
    "evaluator",
    "policy_digest",
    "closure_digest",
    "evaluator_build_digest",
    "metrics",
    "gate_decision",
    "created_at"
  ],
  "title": "QualityAttestation",
  "type": "object"
}
