{
  "$defs": {
    "MetricObservation": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "$ref": "#/$defs/PilotMetric"
        },
        "success_weight": {
          "minimum": 0,
          "title": "Success Weight",
          "type": "number"
        },
        "total_weight": {
          "exclusiveMinimum": 0,
          "title": "Total Weight",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "success_weight",
        "total_weight"
      ],
      "title": "MetricObservation",
      "type": "object"
    },
    "PilotDocumentObservation": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricObservation"
          },
          "minItems": 1,
          "title": "Metrics",
          "type": "array"
        },
        "risk_items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RiskItemObservation"
          },
          "title": "Risk Items",
          "type": "array"
        },
        "serious_error_codes": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Serious Error Codes",
          "type": "array"
        },
        "source_group_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/PilotSplit"
        },
        "stability_runs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StabilityRunObservation"
          },
          "title": "Stability Runs",
          "type": "array"
        },
        "strata": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StringValue"
          },
          "title": "Strata",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "source_group_id",
        "split",
        "metrics"
      ],
      "title": "PilotDocumentObservation",
      "type": "object"
    },
    "PilotEvaluationPolicy": {
      "additionalProperties": false,
      "properties": {
        "metric_thresholds": {
          "items": {
            "$ref": "#/$defs/PilotMetricThreshold"
          },
          "minItems": 1,
          "title": "Metric Thresholds",
          "type": "array"
        },
        "minimum_document_count": {
          "minimum": 1,
          "title": "Minimum Document Count",
          "type": "integer"
        },
        "minimum_edge_jaccard": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Edge Jaccard"
        },
        "minimum_node_jaccard": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Node Jaccard"
        },
        "minimum_slice_documents": {
          "default": 2,
          "minimum": 1,
          "title": "Minimum Slice Documents",
          "type": "integer"
        },
        "minimum_stability_runs": {
          "default": 5,
          "minimum": 2,
          "title": "Minimum Stability Runs",
          "type": "integer"
        },
        "policy_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "risk_coverage_targets": {
          "default": [
            0.25,
            0.5,
            0.75,
            1.0
          ],
          "items": {
            "type": "number"
          },
          "title": "Risk Coverage Targets",
          "type": "array"
        },
        "split_requirements": {
          "items": {
            "$ref": "#/$defs/SplitRequirement"
          },
          "title": "Split Requirements",
          "type": "array"
        },
        "worst_document_fraction": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Worst Document Fraction",
          "type": "number"
        }
      },
      "required": [
        "policy_version",
        "minimum_document_count",
        "split_requirements",
        "metric_thresholds"
      ],
      "title": "PilotEvaluationPolicy",
      "type": "object"
    },
    "PilotMetric": {
      "enum": [
        "claim_precision",
        "evidence_alignment",
        "must_have_recall",
        "region_accounting",
        "replan_serious_error_recall",
        "authority_compliance",
        "direct_parent_precision",
        "direct_parent_recall",
        "ancestor_f1",
        "source_order_score",
        "branch_purity",
        "branch_theme_clean_rate",
        "sibling_granularity_consistency",
        "fragment_root_free_rate",
        "published_claim_coverage",
        "high_value_resolution_rate"
      ],
      "title": "PilotMetric",
      "type": "string"
    },
    "PilotMetricThreshold": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "$ref": "#/$defs/PilotMetric"
        },
        "minimum": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "per_document_hard_gate": {
          "default": false,
          "title": "Per Document Hard Gate",
          "type": "boolean"
        },
        "per_slice_hard_gate": {
          "default": false,
          "title": "Per Slice Hard Gate",
          "type": "boolean"
        }
      },
      "required": [
        "metric"
      ],
      "title": "PilotMetricThreshold",
      "type": "object"
    },
    "PilotSplit": {
      "enum": [
        "development",
        "calibration",
        "sealed_blind"
      ],
      "title": "PilotSplit",
      "type": "string"
    },
    "RiskItemObservation": {
      "additionalProperties": false,
      "properties": {
        "importance_weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Importance Weight",
          "type": "number"
        },
        "is_error": {
          "title": "Is Error",
          "type": "boolean"
        },
        "item_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "predicted_risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Predicted Risk",
          "type": "number"
        }
      },
      "required": [
        "item_id",
        "predicted_risk",
        "is_error"
      ],
      "title": "RiskItemObservation",
      "type": "object"
    },
    "SplitRequirement": {
      "additionalProperties": false,
      "properties": {
        "minimum_documents": {
          "minimum": 0,
          "title": "Minimum Documents",
          "type": "integer"
        },
        "split": {
          "$ref": "#/$defs/PilotSplit"
        }
      },
      "required": [
        "split",
        "minimum_documents"
      ],
      "title": "SplitRequirement",
      "type": "object"
    },
    "StabilityRunObservation": {
      "additionalProperties": false,
      "properties": {
        "concept_keys": {
          "default": [],
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Concept Keys",
          "type": "array"
        },
        "direct_parent_keys": {
          "default": [],
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "title": "Direct Parent Keys",
          "type": "array"
        },
        "run_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Run Key",
          "type": "string"
        }
      },
      "required": [
        "run_key"
      ],
      "title": "StabilityRunObservation",
      "type": "object"
    },
    "StringValue": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 4096,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "StringValue",
      "type": "object"
    }
  },
  "$id": "urn:zlb:vnext:schema:pilot-dataset:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "pattern": "^pilot_[A-Za-z0-9._-]{1,96}$",
      "title": "Dataset Id",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/PilotDocumentObservation"
      },
      "minItems": 1,
      "title": "Documents",
      "type": "array"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/PilotEvaluationPolicy"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "frozen_at",
    "policy",
    "documents"
  ],
  "title": "PilotDataset",
  "type": "object"
}
