{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "relation_proposal_ledger",
        "relation_assessment_ledger",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "RuntimeRole": {
      "enum": [
        "run_governor",
        "document_interpreter",
        "source_inventory_auditor",
        "global_structure_planner",
        "recursive_region_planner",
        "region_decision_verifier",
        "claim_atomizer",
        "omission_auditor",
        "bottom_up_region_auditor",
        "claim_fidelity_verifier",
        "domain_resolver",
        "relation_proposer",
        "canonicalizer",
        "relation_verifier_a",
        "relation_verifier_b",
        "arbiter",
        "quality_auditor",
        "projection_planner",
        "release_evidence_aggregator",
        "canary_observation_aggregator"
      ],
      "title": "RuntimeRole",
      "type": "string"
    },
    "StringValue": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 4096,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "StringValue",
      "type": "object"
    }
  },
  "$id": "urn:zlb:vnext:schema:recorded-interaction:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "interaction_id": {
      "pattern": "^interaction_[0-9a-f]{32}$",
      "title": "Interaction Id",
      "type": "string"
    },
    "model_revision": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Model Revision",
      "type": "string"
    },
    "owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "provider": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "provider_metadata": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StringValue"
      },
      "title": "Provider Metadata",
      "type": "array"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "request_ref": {
      "$ref": "#/$defs/EvidenceRef"
    },
    "response_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Response Digest",
      "type": "string"
    },
    "response_ref": {
      "$ref": "#/$defs/EvidenceRef"
    },
    "role": {
      "$ref": "#/$defs/RuntimeRole"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_key": {
      "pattern": "^[a-z][a-z0-9._:-]{1,127}$",
      "title": "Stage Key",
      "type": "string"
    },
    "tool_result_digests": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Tool Result Digests",
      "type": "array"
    },
    "tool_result_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Tool Result Refs",
      "type": "array"
    }
  },
  "required": [
    "interaction_id",
    "run_id",
    "owner_id",
    "stage_key",
    "role",
    "provider",
    "model_revision",
    "request_ref",
    "response_ref",
    "request_digest",
    "response_digest",
    "created_at"
  ],
  "title": "RecordedInteraction",
  "type": "object"
}
