{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "ReplayStage": {
      "enum": [
        "source_observation",
        "source_inventory",
        "region_planning",
        "claim_ledger",
        "omission_audit",
        "canonical_graph",
        "cross_links",
        "projection",
        "exports",
        "quality"
      ],
      "title": "ReplayStage",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:affected-replay-plan:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_concept_ids": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Affected Concept Ids",
      "type": "array"
    },
    "affected_relation_ids": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Affected Relation Ids",
      "type": "array"
    },
    "affected_source_ids": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Affected Source Ids",
      "type": "array"
    },
    "base_artifact_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Base Artifact Refs",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^review_decision_[0-9a-f]{32}$",
      "title": "Decision Id",
      "type": "string"
    },
    "invalidated_stages": {
      "items": {
        "$ref": "#/$defs/ReplayStage"
      },
      "minItems": 1,
      "title": "Invalidated Stages",
      "type": "array"
    },
    "minimum_replan_region_id": {
      "anyOf": [
        {
          "pattern": "^reg_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Replan Region Id"
    },
    "owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "preserve_human_decision_ids": {
      "items": {
        "pattern": "^review_decision_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Preserve Human Decision Ids",
      "type": "array"
    },
    "reason_codes": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "replay_plan_id": {
      "pattern": "^replay_plan_[0-9a-f]{32}$",
      "title": "Replay Plan Id",
      "type": "string"
    },
    "review_id": {
      "pattern": "^review_[0-9a-f]{32}$",
      "title": "Review Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "replay_plan_id",
    "owner_id",
    "run_id",
    "review_id",
    "decision_id",
    "base_artifact_refs",
    "invalidated_stages",
    "preserve_human_decision_ids",
    "reason_codes",
    "created_at"
  ],
  "title": "AffectedReplayPlan",
  "type": "object"
}
