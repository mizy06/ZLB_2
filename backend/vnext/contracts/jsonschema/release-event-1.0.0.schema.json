{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "relation_proposal_ledger",
        "relation_assessment_ledger",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "CanaryDecision": {
      "enum": [
        "hold",
        "advance",
        "rollback"
      ],
      "title": "CanaryDecision",
      "type": "string"
    },
    "CanaryStage": {
      "enum": [
        "shadow",
        "allowlist",
        "percent_1",
        "percent_5",
        "percent_20",
        "percent_50",
        "default"
      ],
      "title": "CanaryStage",
      "type": "string"
    },
    "CanaryTransitionDecision": {
      "additionalProperties": false,
      "properties": {
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/CanaryDecision"
        },
        "decision_id": {
          "pattern": "^canary_decision_[0-9a-f]{32}$",
          "title": "Decision Id",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "from_stage": {
          "$ref": "#/$defs/CanaryStage"
        },
        "observation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Observation Digest",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "release_id": {
          "pattern": "^release_[0-9a-f]{32}$",
          "title": "Release Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "to_stage": {
          "$ref": "#/$defs/CanaryStage"
        }
      },
      "required": [
        "decision_id",
        "release_id",
        "from_stage",
        "to_stage",
        "decision",
        "policy_digest",
        "evidence_digest",
        "observation_digest",
        "reason_codes",
        "decided_at"
      ],
      "title": "CanaryTransitionDecision",
      "type": "object"
    },
    "ReleaseEventType": {
      "enum": [
        "canary_decision",
        "rollback"
      ],
      "title": "ReleaseEventType",
      "type": "string"
    },
    "ReleasePointerSnapshot": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "pointer_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Pointer Key",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "pointer_key",
        "artifact_ref",
        "version",
        "updated_at"
      ],
      "title": "ReleasePointerSnapshot",
      "type": "object"
    },
    "RollbackRecord": {
      "additionalProperties": false,
      "properties": {
        "from_artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "pointer_key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Pointer Key",
          "type": "string"
        },
        "pointer_version": {
          "minimum": 1,
          "title": "Pointer Version",
          "type": "integer"
        },
        "reason_codes": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "release_id": {
          "pattern": "^release_[0-9a-f]{32}$",
          "title": "Release Id",
          "type": "string"
        },
        "restored_artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "rollback_id": {
          "pattern": "^rollback_[0-9a-f]{32}$",
          "title": "Rollback Id",
          "type": "string"
        },
        "rolled_back_at": {
          "format": "date-time",
          "title": "Rolled Back At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "rollback_id",
        "release_id",
        "owner_id",
        "from_artifact_ref",
        "restored_artifact_ref",
        "pointer_key",
        "pointer_version",
        "reason_codes",
        "rolled_back_at"
      ],
      "title": "RollbackRecord",
      "type": "object"
    }
  },
  "$id": "urn:zlb:vnext:schema:release-event:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/CanaryTransitionDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "event_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Event Digest",
      "type": "string"
    },
    "event_id": {
      "pattern": "^release_event_[0-9a-f]{32}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/ReleaseEventType"
    },
    "owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "pointer_after": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleasePointerSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pointer_before": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleasePointerSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "previous_event_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Event Digest"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "release_id": {
      "pattern": "^release_[0-9a-f]{32}$",
      "title": "Release Id",
      "type": "string"
    },
    "rollback": {
      "anyOf": [
        {
          "$ref": "#/$defs/RollbackRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "owner_id",
    "release_id",
    "sequence",
    "event_type",
    "event_digest",
    "recorded_at"
  ],
  "title": "ReleaseEvent",
  "type": "object"
}
