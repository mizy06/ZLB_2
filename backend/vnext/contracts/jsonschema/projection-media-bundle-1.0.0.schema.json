{
  "$defs": {
    "AccessibilityProfile": {
      "additionalProperties": false,
      "properties": {
        "body_font_size": {
          "minimum": 0,
          "title": "Body Font Size",
          "type": "number"
        },
        "chapter_font_size": {
          "minimum": 0,
          "title": "Chapter Font Size",
          "type": "number"
        },
        "dom_outline_present": {
          "title": "Dom Outline Present",
          "type": "boolean"
        },
        "keyboard_navigation": {
          "title": "Keyboard Navigation",
          "type": "boolean"
        },
        "line_height": {
          "minimum": 1,
          "title": "Line Height",
          "type": "number"
        },
        "long_description_present": {
          "title": "Long Description Present",
          "type": "boolean"
        },
        "minimum_target_size": {
          "minimum": 0,
          "title": "Minimum Target Size",
          "type": "integer"
        },
        "non_text_contrast_ratio": {
          "minimum": 1,
          "title": "Non Text Contrast Ratio",
          "type": "number"
        },
        "normal_node_font_size": {
          "minimum": 0,
          "title": "Normal Node Font Size",
          "type": "number"
        },
        "reflow_width_css_px": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reflow Width Css Px"
        },
        "text_contrast_ratio": {
          "minimum": 1,
          "title": "Text Contrast Ratio",
          "type": "number"
        },
        "text_zoom_percent": {
          "minimum": 100,
          "title": "Text Zoom Percent",
          "type": "integer"
        }
      },
      "required": [
        "normal_node_font_size",
        "chapter_font_size",
        "body_font_size",
        "line_height",
        "text_contrast_ratio",
        "non_text_contrast_ratio",
        "minimum_target_size",
        "text_zoom_percent",
        "dom_outline_present",
        "keyboard_navigation",
        "long_description_present"
      ],
      "title": "AccessibilityProfile",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "MediaCrossLinkIdentity": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Relation Id",
          "type": "string"
        },
        "semantic_relation": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Semantic Relation",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "relation_id",
        "source_id",
        "target_id",
        "semantic_relation"
      ],
      "title": "MediaCrossLinkIdentity",
      "type": "object"
    },
    "MediaNodeIdentity": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "node_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Node Id",
          "type": "string"
        },
        "source_order": {
          "minimum": 0,
          "title": "Source Order",
          "type": "integer"
        },
        "status": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "label",
        "status",
        "source_order"
      ],
      "title": "MediaNodeIdentity",
      "type": "object"
    },
    "MediaParentIdentity": {
      "additionalProperties": false,
      "properties": {
        "alternate_edge_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Alternate Edge Ids",
          "type": "array"
        },
        "child_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Child Id",
          "type": "string"
        },
        "parent_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Parent Id",
          "type": "string"
        },
        "selected_edge_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Selected Edge Id",
          "type": "string"
        },
        "suppressed_edge_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Suppressed Edge Ids",
          "type": "array"
        }
      },
      "required": [
        "child_id",
        "parent_id",
        "selected_edge_id"
      ],
      "title": "MediaParentIdentity",
      "type": "object"
    },
    "MediaProjectionContract": {
      "additionalProperties": false,
      "properties": {
        "accessibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessibilityProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cross_links": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MediaCrossLinkIdentity"
          },
          "title": "Cross Links",
          "type": "array"
        },
        "geometry_profile": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Geometry Profile",
          "type": "string"
        },
        "graphical_node_limit": {
          "minimum": 0,
          "title": "Graphical Node Limit",
          "type": "integer"
        },
        "hidden_ids": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 3,
            "type": "string"
          },
          "title": "Hidden Ids",
          "type": "array"
        },
        "long_description": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Long Description"
        },
        "medium": {
          "$ref": "#/$defs/PresentationMedium"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/MediaNodeIdentity"
          },
          "title": "Nodes",
          "type": "array"
        },
        "overlay_enabled": {
          "title": "Overlay Enabled",
          "type": "boolean"
        },
        "overlay_mode": {
          "$ref": "#/$defs/OverlayMode"
        },
        "page_or_tile_count": {
          "minimum": 1,
          "title": "Page Or Tile Count",
          "type": "integer"
        },
        "paginated": {
          "title": "Paginated",
          "type": "boolean"
        },
        "parents": {
          "items": {
            "$ref": "#/$defs/MediaParentIdentity"
          },
          "title": "Parents",
          "type": "array"
        },
        "render_mode": {
          "enum": [
            "canvas_dom_sync",
            "outline_detail",
            "paged_tiles",
            "bookmarked_pages",
            "structured_json"
          ],
          "title": "Render Mode",
          "type": "string"
        },
        "semantic_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Semantic Fingerprint",
          "type": "string"
        },
        "view_edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MediaViewEdgeIdentity"
          },
          "title": "View Edges",
          "type": "array"
        }
      },
      "required": [
        "medium",
        "semantic_fingerprint",
        "nodes",
        "parents",
        "overlay_mode",
        "overlay_enabled",
        "render_mode",
        "geometry_profile",
        "graphical_node_limit",
        "paginated",
        "page_or_tile_count"
      ],
      "title": "MediaProjectionContract",
      "type": "object"
    },
    "MediaViewEdgeIdentity": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "maxLength": 256,
          "minLength": 3,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "source_id",
        "target_id"
      ],
      "title": "MediaViewEdgeIdentity",
      "type": "object"
    },
    "OverlayMode": {
      "enum": [
        "source_only",
        "grounded_assist",
        "enriched_overlay"
      ],
      "title": "OverlayMode",
      "type": "string"
    },
    "PresentationMedium": {
      "enum": [
        "web",
        "mobile",
        "png",
        "pdf",
        "json"
      ],
      "title": "PresentationMedium",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:projection-media-bundle:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_graph_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "media": {
      "items": {
        "$ref": "#/$defs/MediaProjectionContract"
      },
      "title": "Media",
      "type": "array"
    },
    "media_bundle_id": {
      "pattern": "^media_bundle_[0-9a-f]{32}$",
      "title": "Media Bundle Id",
      "type": "string"
    },
    "projection_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Semantic Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "media_bundle_id",
    "canonical_graph_ref",
    "projection_ref",
    "semantic_fingerprint",
    "media",
    "created_at"
  ],
  "title": "ProjectionMediaBundle",
  "type": "object"
}
