{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "relation_proposal_ledger",
        "relation_assessment_ledger",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "BlockIR": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "block_id": {
          "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
          "title": "Block Id",
          "type": "string"
        },
        "char_spans": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CharSpan"
          },
          "title": "Char Spans",
          "type": "array"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/BlockKind"
        },
        "native_object_id": {
          "anyOf": [
            {
              "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Object Id"
        },
        "native_order_hint": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Order Hint"
        },
        "observation_status": {
          "$ref": "#/$defs/InterpretationStatus"
        },
        "page_id": {
          "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
          "title": "Page Id",
          "type": "string"
        },
        "parent_group_id": {
          "anyOf": [
            {
              "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Group Id"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "source_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Source Confidence",
          "type": "number"
        },
        "source_layer": {
          "$ref": "#/$defs/SourceLayer"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "page_id",
        "kind",
        "text",
        "source_layer",
        "source_confidence",
        "observation_status",
        "producer"
      ],
      "title": "BlockIR",
      "type": "object"
    },
    "BlockKind": {
      "enum": [
        "title",
        "heading",
        "paragraph",
        "list",
        "caption",
        "note",
        "table_text",
        "formula_text",
        "reaction_text",
        "other"
      ],
      "title": "BlockKind",
      "type": "string"
    },
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/CoordinateUnit"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height",
        "unit"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "CharSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CharSpan",
      "type": "object"
    },
    "ChemicalReactionIR": {
      "additionalProperties": false,
      "properties": {
        "arrow": {
          "default": "->",
          "maxLength": 32,
          "minLength": 1,
          "title": "Arrow",
          "type": "string"
        },
        "arrow_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Arrow Evidence Refs",
          "type": "array"
        },
        "conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReactionCondition"
          },
          "title": "Conditions",
          "type": "array"
        },
        "direction": {
          "default": "unknown",
          "enum": [
            "forward",
            "reverse",
            "equilibrium",
            "unknown"
          ],
          "title": "Direction",
          "type": "string"
        },
        "direction_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Direction Evidence Refs",
          "type": "array"
        },
        "parse_status": {
          "default": "unresolved",
          "enum": [
            "parsed",
            "partial",
            "unresolved"
          ],
          "title": "Parse Status",
          "type": "string"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/ReactionParticipant"
          },
          "title": "Products",
          "type": "array"
        },
        "reactants": {
          "items": {
            "$ref": "#/$defs/ReactionParticipant"
          },
          "title": "Reactants",
          "type": "array"
        },
        "reagents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReactionParticipant"
          },
          "title": "Reagents",
          "type": "array"
        },
        "step": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "step_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Step Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "reactants",
        "products"
      ],
      "title": "ChemicalReactionIR",
      "type": "object"
    },
    "ContinuityRelation": {
      "enum": [
        "same_section",
        "continued_from",
        "continued_to",
        "aside_of",
        "returns_to",
        "review_of",
        "repetition_of"
      ],
      "title": "ContinuityRelation",
      "type": "string"
    },
    "CoordinateUnit": {
      "enum": [
        "point",
        "pixel",
        "normalized"
      ],
      "title": "CoordinateUnit",
      "type": "string"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FormulaIR": {
      "additionalProperties": false,
      "properties": {
        "ast_serialization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ast Serialization"
        },
        "display_text": {
          "title": "Display Text",
          "type": "string"
        },
        "latex": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latex"
        },
        "parse_status": {
          "default": "unresolved",
          "enum": [
            "parsed",
            "partial",
            "unresolved"
          ],
          "title": "Parse Status",
          "type": "string"
        },
        "render_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "symbols": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FormulaSymbol"
          },
          "title": "Symbols",
          "type": "array"
        }
      },
      "required": [
        "display_text",
        "render_ref"
      ],
      "title": "FormulaIR",
      "type": "object"
    },
    "FormulaSymbol": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "symbol": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "confidence"
      ],
      "title": "FormulaSymbol",
      "type": "object"
    },
    "HypothesisKind": {
      "enum": [
        "continuity",
        "outline_alignment",
        "section_interval",
        "title_match"
      ],
      "title": "HypothesisKind",
      "type": "string"
    },
    "InterpretationHypothesis": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "continuity_relation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContinuityRelation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "hypothesis_id": {
          "pattern": "^hyp_[0-9a-f]{32}$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "hypothesis_type": {
          "$ref": "#/$defs/HypothesisKind"
        },
        "interpretation_status": {
          "$ref": "#/$defs/InterpretationStatus"
        },
        "label": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "related_source_ids": {
          "default": [],
          "items": {
            "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Related Source Ids",
          "type": "array"
        },
        "subject_source_ids": {
          "items": {
            "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Subject Source Ids",
          "type": "array"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^hyp_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        }
      },
      "required": [
        "hypothesis_id",
        "hypothesis_type",
        "subject_source_ids",
        "label",
        "confidence",
        "interpretation_status",
        "producer",
        "evidence_refs"
      ],
      "title": "InterpretationHypothesis",
      "type": "object"
    },
    "InterpretationStatus": {
      "enum": [
        "observed",
        "inferred",
        "contested",
        "human_confirmed",
        "rejected"
      ],
      "title": "InterpretationStatus",
      "type": "string"
    },
    "NativeObjectIR": {
      "additionalProperties": false,
      "properties": {
        "asset_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "formula": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormulaIR"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/NativeObjectKind"
        },
        "native_order_hint": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Order Hint"
        },
        "object_id": {
          "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
          "title": "Object Id",
          "type": "string"
        },
        "observation_status": {
          "$ref": "#/$defs/InterpretationStatus",
          "default": "observed"
        },
        "page_id": {
          "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
          "title": "Page Id",
          "type": "string"
        },
        "parent_group_id": {
          "anyOf": [
            {
              "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Group Id"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "reaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChemicalReactionIR"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_layer": {
          "$ref": "#/$defs/SourceLayer"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableIR"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "page_id",
        "kind",
        "source_layer",
        "producer"
      ],
      "title": "NativeObjectIR",
      "type": "object"
    },
    "NativeObjectKind": {
      "enum": [
        "text",
        "image",
        "table",
        "formula",
        "chemical_reaction",
        "chart",
        "shape",
        "group",
        "note",
        "link",
        "other"
      ],
      "title": "NativeObjectKind",
      "type": "string"
    },
    "ObservedOrderSignal": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/OrderSignalKind"
        },
        "ordered_source_ids": {
          "items": {
            "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Ordered Source Ids",
          "type": "array"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "signal_id": {
          "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
          "title": "Signal Id",
          "type": "string"
        }
      },
      "required": [
        "signal_id",
        "kind",
        "ordered_source_ids",
        "producer"
      ],
      "title": "ObservedOrderSignal",
      "type": "object"
    },
    "OrderSignalKind": {
      "enum": [
        "native_sequence",
        "title_priority",
        "column_geometry",
        "group_membership",
        "z_order",
        "visual_flow"
      ],
      "title": "OrderSignalKind",
      "type": "string"
    },
    "OutlineEntryIR": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "label": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "native_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Target"
        },
        "observed_level": {
          "minimum": 1,
          "title": "Observed Level",
          "type": "integer"
        },
        "outline_entry_id": {
          "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
          "title": "Outline Entry Id",
          "type": "string"
        },
        "producer": {
          "$ref": "#/$defs/ProducerRef"
        },
        "source_order": {
          "minimum": 0,
          "title": "Source Order",
          "type": "integer"
        },
        "target_page_id": {
          "anyOf": [
            {
              "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Page Id"
        }
      },
      "required": [
        "outline_entry_id",
        "label",
        "observed_level",
        "source_order",
        "producer",
        "evidence_refs"
      ],
      "title": "OutlineEntryIR",
      "type": "object"
    },
    "PageDimensions": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/CoordinateUnit"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "width",
        "height",
