{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "relation_proposal_ledger",
        "relation_assessment_ledger",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:rollback-record:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "from_artifact_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "pointer_key": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Pointer Key",
      "type": "string"
    },
    "pointer_version": {
      "minimum": 1,
      "title": "Pointer Version",
      "type": "integer"
    },
    "reason_codes": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "release_id": {
      "pattern": "^release_[0-9a-f]{32}$",
      "title": "Release Id",
      "type": "string"
    },
    "restored_artifact_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "rollback_id": {
      "pattern": "^rollback_[0-9a-f]{32}$",
      "title": "Rollback Id",
      "type": "string"
    },
    "rolled_back_at": {
      "format": "date-time",
      "title": "Rolled Back At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "rollback_id",
    "release_id",
    "owner_id",
    "from_artifact_ref",
    "restored_artifact_ref",
    "pointer_key",
    "pointer_version",
    "reason_codes",
    "rolled_back_at"
  ],
  "title": "RollbackRecord",
  "type": "object"
}
