{
  "$defs": {
    "RuntimeRole": {
      "enum": [
        "run_governor",
        "document_interpreter",
        "source_inventory_auditor",
        "global_structure_planner",
        "recursive_region_planner",
        "region_decision_verifier",
        "claim_atomizer",
        "omission_auditor",
        "bottom_up_region_auditor",
        "claim_fidelity_verifier",
        "domain_resolver",
        "relation_proposer",
        "canonicalizer",
        "relation_verifier_a",
        "relation_verifier_b",
        "arbiter",
        "quality_auditor",
        "projection_planner",
        "release_evidence_aggregator",
        "canary_observation_aggregator"
      ],
      "title": "RuntimeRole",
      "type": "string"
    },
    "TaskBudgetSlice": {
      "additionalProperties": false,
      "properties": {
        "max_calls": {
          "minimum": 0,
          "title": "Max Calls",
          "type": "integer"
        },
        "max_cost_microunits": {
          "minimum": 0,
          "title": "Max Cost Microunits",
          "type": "integer"
        },
        "max_wall_seconds": {
          "minimum": 1,
          "title": "Max Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_wall_seconds",
        "max_calls",
        "max_cost_microunits"
      ],
      "title": "TaskBudgetSlice",
      "type": "object"
    }
  },
  "$id": "urn:zlb:vnext:schema:task-envelope:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Artifact Version",
      "type": "string"
    },
    "budget_slice": {
      "$ref": "#/$defs/TaskBudgetSlice"
    },
    "expected_artifact_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Expected Artifact Version",
      "type": "string"
    },
    "idempotency_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "output_schema": {
      "pattern": "^urn:zlb:vnext:schema:[a-z0-9-]+:[0-9.]+$",
      "title": "Output Schema",
      "type": "string"
    },
    "role_policy": {
      "$ref": "#/$defs/RuntimeRole"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    }
  },
  "required": [
    "artifact_version",
    "source_ids",
    "role_policy",
    "budget_slice",
    "output_schema",
    "expected_artifact_version",
    "idempotency_key"
  ],
  "title": "TaskEnvelope",
  "type": "object"
}
