{
  "$defs": {
    "ArtifactProducerRef": {
      "additionalProperties": false,
      "properties": {
        "model_revision": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "producer_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Producer Version",
          "type": "string"
        },
        "prompt_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Digest"
        },
        "role": {
          "$ref": "#/$defs/RuntimeRole"
        }
      },
      "required": [
        "producer_id",
        "producer_version",
        "role"
      ],
      "title": "ArtifactProducerRef",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "relation_proposal_ledger",
        "relation_assessment_ledger",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "RuntimeRole": {
      "enum": [
        "run_governor",
        "document_interpreter",
        "source_inventory_auditor",
        "global_structure_planner",
        "recursive_region_planner",
        "region_decision_verifier",
        "claim_atomizer",
        "omission_auditor",
        "bottom_up_region_auditor",
        "claim_fidelity_verifier",
        "domain_resolver",
        "relation_proposer",
        "canonicalizer",
        "relation_verifier_a",
        "relation_verifier_b",
        "arbiter",
        "quality_auditor",
        "projection_planner",
        "release_evidence_aggregator",
        "canary_observation_aggregator"
      ],
      "title": "RuntimeRole",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:artifact-envelope:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "source_observation_ir"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload_schema_version": {
            "const": "1.0.0"
          },
          "producer": {
            "properties": {
              "role": {
                "enum": [
                  "document_interpreter"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "schema_id": {
            "const": "urn:zlb:vnext:schema:source-observation-ir:1.0.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "source_inventory"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload_schema_version": {
            "const": "1.0.0"
          },
          "producer": {
            "properties": {
              "role": {
                "enum": [
                  "source_inventory_auditor"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "schema_id": {
            "const": "urn:zlb:vnext:schema:source-inventory:1.0.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "region_plan"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload_schema_version": {
            "const": "1.0.0"
          },
          "producer": {
            "properties": {
              "role": {
                "enum": [
                  "global_structure_planner",
                  "recursive_region_planner"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "schema_id": {
            "const": "urn:zlb:vnext:schema:region-plan:1.0.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "region_split_certificate"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload_schema_version": {
            "const": "1.0.0"
          },
          "producer": {
            "properties": {
              "role": {
                "enum": [
                  "region_decision_verifier"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "schema_id": {
            "const": "urn:zlb:vnext:schema:region-split-certificate:1.0.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "replan_request"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload_schema_version": {
            "const": "1.0.0"
          },
          "producer": {
            "properties": {
              "role": {
                "enum": [
                  "bottom_up_region_auditor"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "schema_id": {
            "const": "urn:zlb:vnext:schema:replan-request:1.0.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "claim_ledger"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload_schema_version": {
            "const": "1.0.0"
          },
          "producer": {
            "properties": {
              "role": {
                "enum": [
                  "claim_atomizer"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "schema_id": {
            "const": "urn:zlb:vnext:schema:claim-ledger:1.0.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "omission_audit"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload_schema_version": {
            "const": "1.0.0"
          },
          "producer": {
            "properties": {
              "role": {
                "enum": [
                  "omission_auditor"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "schema_id": {
            "const": "urn:zlb:vnext:schema:omission-audit:1.0.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "relation_proposal_ledger"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload_schema_version": {
            "const": "1.0.0"
          },
          "producer": {
            "properties": {
              "role": {
                "enum": [
                  "relation_proposer"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "schema_id": {
            "const": "urn:zlb:vnext:schema:relation-proposal-ledger:1.0.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "relation_assessment_ledger"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload_schema_version": {
            "const": "1.0.0"
          },
          "producer": {
            "properties": {
              "role": {
                "enum": [
                  "relation_verifier_a",
                  "relation_verifier_b"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "schema_id": {
            "const": "urn:zlb:vnext:schema:relation-assessment-ledger:1.0.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "canonical_explicit_graph"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload_schema_version": {
            "const": "0.1.0"
          },
          "producer": {
            "properties": {
              "role": {
                "enum": [
                  "canonicalizer"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "schema_id": {
            "const": "urn:zlb:vnext:schema:canonical-explicit-graph:0.1.0"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_type": {
            "const": "diagnostic_projection"
          }
        },
        "required": [
          "artifact_type"
        ]
      },
      "then": {
        "properties": {
          "payload_schema_version": {
            "const": "0.1.0"
          },
          "producer": {
            "properties": {
              "role": {
                "enum": [
                  "projection_planner"
                ]
              }
            },
            "required": [
              "role"
            ]
          },
          "schema_id": {
            "const": "urn:zlb:vnext:schema:diagnostic-projection:0.1.0"
          }
        }
      }
    }
  ],
  "properties": {
    "artifact_id": {
      "pattern": "^art_[0-9a-f]{32}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "$ref": "#/$defs/ArtifactType"
    },
    "canonicalization_profile": {
      "const": "RFC8785",
      "default": "RFC8785",
      "title": "Canonicalization Profile",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "external_snapshot_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "External Snapshot Refs",
      "type": "array"
    },
    "input_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "payload_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Payload Digest",
      "type": "string"
    },
    "payload_schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Payload Schema Version",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/ArtifactProducerRef"
    },
    "schema_id": {
      "pattern": "^urn:zlb:vnext:schema:[a-z0-9-]+:[0-9.]+$",
      "title": "Schema Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "artifact_id",
    "artifact_type",
    "schema_id",
    "payload_schema_version",
    "owner_id",
    "payload_digest",
    "producer",
    "created_at"
  ],
  "title": "ArtifactEnvelope",
  "type": "object"
}
