{
  "$defs": {
    "RegionProposalAction": {
      "enum": [
        "SPLIT",
        "STOP",
        "UNRESOLVED"
      ],
      "title": "RegionProposalAction",
      "type": "string"
    },
    "RegionSplitSemanticAssessment": {
      "additionalProperties": false,
      "properties": {
        "boundaries_explainable": {
          "title": "Boundaries Explainable",
          "type": "boolean"
        },
        "child_labels_self_contained": {
          "title": "Child Labels Self Contained",
          "type": "boolean"
        },
        "parent_common_concept_supported": {
          "title": "Parent Common Concept Supported",
          "type": "boolean"
        },
        "sibling_granularity_comparable": {
          "title": "Sibling Granularity Comparable",
          "type": "boolean"
        },
        "sibling_separation": {
          "title": "Sibling Separation",
          "type": "boolean"
        },
        "within_region_cohesion": {
          "title": "Within Region Cohesion",
          "type": "boolean"
        }
      },
      "required": [
        "parent_common_concept_supported",
        "child_labels_self_contained",
        "sibling_separation",
        "within_region_cohesion",
        "sibling_granularity_comparable",
        "boundaries_explainable"
      ],
      "title": "RegionSplitSemanticAssessment",
      "type": "object"
    },
    "RegionStopSemanticAssessment": {
      "additionalProperties": false,
      "properties": {
        "claims_have_comparable_granularity": {
          "title": "Claims Have Comparable Granularity",
          "type": "boolean"
        },
        "further_split_would_fragment_or_duplicate": {
          "title": "Further Split Would Fragment Or Duplicate",
          "type": "boolean"
        },
        "no_mixed_theme_evidence": {
          "title": "No Mixed Theme Evidence",
          "type": "boolean"
        },
        "single_instructional_intent": {
          "title": "Single Instructional Intent",
          "type": "boolean"
        }
      },
      "required": [
        "single_instructional_intent",
        "claims_have_comparable_granularity",
        "further_split_would_fragment_or_duplicate",
        "no_mixed_theme_evidence"
      ],
      "title": "RegionStopSemanticAssessment",
      "type": "object"
    },
    "RegionVerificationVerdict": {
      "enum": [
        "accept",
        "reject",
        "unresolved"
      ],
      "title": "RegionVerificationVerdict",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:region-decision-verification:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/RegionProposalAction"
    },
    "anchor_source_id": {
      "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
      "title": "Anchor Source Id",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split_assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegionSplitSemanticAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stop_assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/RegionStopSemanticAssessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "supporting_source_ids": {
      "items": {
        "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Supporting Source Ids",
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/RegionVerificationVerdict"
    }
  },
  "required": [
    "anchor_source_id",
    "action",
    "verdict",
    "supporting_source_ids",
    "rationale"
  ],
  "title": "RegionDecisionVerification",
  "type": "object"
}
