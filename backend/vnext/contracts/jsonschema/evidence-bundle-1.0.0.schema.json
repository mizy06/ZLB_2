{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "relation_proposal_ledger",
        "relation_assessment_ledger",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExternalEvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "canonical_url": {
          "maxLength": 2048,
          "minLength": 8,
          "title": "Canonical Url",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "external_ref_id": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "license_note": {
          "maxLength": 512,
          "minLength": 1,
          "title": "License Note",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "publisher": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "quote_span": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Quote Span",
          "type": "string"
        },
        "relation_to_claim": {
          "$ref": "#/$defs/ExternalRelation"
        },
        "snapshot_id": {
          "pattern": "^snapshot_[0-9a-f]{32}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "trust_tier": {
          "enum": [
            "primary",
            "authoritative",
            "secondary",
            "unknown"
          ],
          "title": "Trust Tier",
          "type": "string"
        }
      },
      "required": [
        "external_ref_id",
        "snapshot_id",
        "canonical_url",
        "publisher",
        "title",
        "fetched_at",
        "content_hash",
        "quote_span",
        "relation_to_claim",
        "trust_tier",
        "license_note"
      ],
      "title": "ExternalEvidenceRecord",
      "type": "object"
    },
    "ExternalRelation": {
      "enum": [
        "supports",
        "contradicts",
        "disambiguates",
        "normalizes",
        "extends",
        "unresolved"
      ],
      "title": "ExternalRelation",
      "type": "string"
    },
    "FetchSnapshot": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "canonical_url": {
          "maxLength": 2048,
          "minLength": 8,
          "title": "Canonical Url",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "injection_signals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Injection Signals",
          "type": "array"
        },
        "mime_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "redirect_chain": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Redirect Chain",
          "type": "array"
        },
        "resolved_ip": {
          "maxLength": 64,
          "minLength": 2,
          "title": "Resolved Ip",
          "type": "string"
        },
        "sanitized_content_ref": {
          "$ref": "#/$defs/EvidenceRef"
        },
        "sanitizer_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sanitizer Version",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^snapshot_[0-9a-f]{32}$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "status_code": {
          "maximum": 599,
          "minimum": 100,
          "title": "Status Code",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "canonical_url",
        "resolved_ip",
        "status_code",
        "mime_type",
        "content_hash",
        "sanitized_content_ref",
        "byte_count",
        "fetched_at",
        "sanitizer_version"
      ],
      "title": "FetchSnapshot",
      "type": "object"
    },
    "SearchBudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "downloaded_bytes": {
          "minimum": 0,
          "title": "Downloaded Bytes",
          "type": "integer"
        },
        "fetches": {
          "minimum": 0,
          "title": "Fetches",
          "type": "integer"
        },
        "queries": {
          "minimum": 0,
          "title": "Queries",
          "type": "integer"
        }
      },
      "required": [
        "queries",
        "fetches",
        "downloaded_bytes"
      ],
      "title": "SearchBudgetUsage",
      "type": "object"
    },
    "SearchQueryRecord": {
      "additionalProperties": false,
      "properties": {
        "executed_at": {
          "format": "date-time",
          "title": "Executed At",
          "type": "string"
        },
        "query": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "result_count": {
          "minimum": 0,
          "title": "Result Count",
          "type": "integer"
        }
      },
      "required": [
        "query",
        "result_count",
        "executed_at"
      ],
      "title": "SearchQueryRecord",
      "type": "object"
    }
  },
  "$id": "urn:zlb:vnext:schema:evidence-bundle:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "budget_usage": {
      "$ref": "#/$defs/SearchBudgetUsage"
    },
    "bundle_id": {
      "pattern": "^evidence_bundle_[0-9a-f]{32}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "conflicts": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "decision": {
      "enum": [
        "allowed",
        "denied",
        "partial"
      ],
      "title": "Decision",
      "type": "string"
    },
    "denial_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Denial Reasons",
      "type": "array"
    },
    "fetch_snapshots": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FetchSnapshot"
      },
      "title": "Fetch Snapshots",
      "type": "array"
    },
    "gateway_policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Gateway Policy Version",
      "type": "string"
    },
    "intent_id": {
      "pattern": "^search_intent_[0-9a-f]{32}$",
      "title": "Intent Id",
      "type": "string"
    },
    "owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "query_log": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SearchQueryRecord"
      },
      "title": "Query Log",
      "type": "array"
    },
    "results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExternalEvidenceRecord"
      },
      "title": "Results",
      "type": "array"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unresolved_questions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    }
  },
  "required": [
    "bundle_id",
    "intent_id",
    "run_id",
    "owner_id",
    "decision",
    "budget_usage",
    "gateway_policy_version"
  ],
  "title": "EvidenceBundle",
  "type": "object"
}
