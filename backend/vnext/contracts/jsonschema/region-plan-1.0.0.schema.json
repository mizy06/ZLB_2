{
  "$defs": {
    "ArtifactProducerRef": {
      "additionalProperties": false,
      "properties": {
        "model_revision": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "producer_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Producer Version",
          "type": "string"
        },
        "prompt_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Digest"
        },
        "role": {
          "$ref": "#/$defs/RuntimeRole"
        }
      },
      "required": [
        "producer_id",
        "producer_version",
        "role"
      ],
      "title": "ArtifactProducerRef",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "RegionPlanStatus": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "unresolved",
        "superseded"
      ],
      "title": "RegionPlanStatus",
      "type": "string"
    },
    "RegionProposalAction": {
      "enum": [
        "SPLIT",
        "STOP",
        "UNRESOLVED"
      ],
      "title": "RegionProposalAction",
      "type": "string"
    },
    "RuntimeRole": {
      "enum": [
        "run_governor",
        "document_interpreter",
        "source_inventory_auditor",
        "global_structure_planner",
        "recursive_region_planner",
        "region_decision_verifier",
        "claim_atomizer",
        "omission_auditor",
        "bottom_up_region_auditor",
        "claim_fidelity_verifier",
        "domain_resolver",
        "canonicalizer",
        "relation_verifier_a",
        "relation_verifier_b",
        "arbiter",
        "quality_auditor",
        "projection_planner"
      ],
      "title": "RuntimeRole",
      "type": "string"
    },
    "SplitEvidenceMode": {
      "enum": [
        "outline",
        "title",
        "courseware_direct",
        "semantic",
        "node_count",
        "token_count",
        "page_capacity"
      ],
      "title": "SplitEvidenceMode",
      "type": "string"
    },
    "SplitProposal": {
      "additionalProperties": false,
      "properties": {
        "child_region_ids": {
          "items": {
            "pattern": "^reg_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Child Region Ids",
          "type": "array"
        },
        "evidence_modes": {
          "items": {
            "$ref": "#/$defs/SplitEvidenceMode"
          },
          "title": "Evidence Modes",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "child_region_ids",
        "rationale",
        "evidence_modes",
        "evidence_refs"
      ],
      "title": "SplitProposal",
      "type": "object"
    },
    "StopProposal": {
      "additionalProperties": false,
      "properties": {
        "claims_have_comparable_granularity": {
          "title": "Claims Have Comparable Granularity",
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "further_split_would_fragment_or_duplicate": {
          "title": "Further Split Would Fragment Or Duplicate",
          "type": "boolean"
        },
        "inventory_reconciled": {
          "title": "Inventory Reconciled",
          "type": "boolean"
        },
        "no_high_importance_omission": {
          "title": "No High Importance Omission",
          "type": "boolean"
        },
        "no_mixed_theme_evidence": {
          "title": "No Mixed Theme Evidence",
          "type": "boolean"
        },
        "no_unhandled_stable_subheading": {
          "title": "No Unhandled Stable Subheading",
          "type": "boolean"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "safety_limit_reached": {
          "default": false,
          "title": "Safety Limit Reached",
          "type": "boolean"
        },
        "single_instructional_intent": {
          "title": "Single Instructional Intent",
          "type": "boolean"
        }
      },
      "required": [
        "single_instructional_intent",
        "no_unhandled_stable_subheading",
        "claims_have_comparable_granularity",
        "inventory_reconciled",
        "further_split_would_fragment_or_duplicate",
        "no_high_importance_omission",
        "no_mixed_theme_evidence",
        "rationale",
        "evidence_refs"
      ],
      "title": "StopProposal",
      "type": "object"
    }
  },
  "$id": "urn:zlb:vnext:schema:region-plan:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ancestor_path": {
      "default": [],
      "items": {
        "pattern": "^reg_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Ancestor Path",
      "type": "array"
    },
    "boundary_context_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Boundary Context Refs",
      "type": "array"
    },
    "child_region_ids": {
      "default": [],
      "items": {
        "pattern": "^reg_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Child Region Ids",
      "type": "array"
    },
    "decision_verifier": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactProducerRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "explicitly_excluded_source_ids": {
      "default": [],
      "items": {
        "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Explicitly Excluded Source Ids",
      "type": "array"
    },
    "parent_region_id": {
      "anyOf": [
        {
          "pattern": "^reg_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Region Id"
    },
    "plan_version": {
      "minimum": 1,
      "title": "Plan Version",
      "type": "integer"
    },
    "planner": {
      "enum": [
        "global_structure_planner",
        "recursive_region_planner"
      ],
      "title": "Planner",
      "type": "string"
    },
    "planner_attempt": {
      "minimum": 1,
      "title": "Planner Attempt",
      "type": "integer"
    },
    "primary_source_memberships": {
      "items": {
        "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Primary Source Memberships",
      "type": "array"
    },
    "proposed_action": {
      "$ref": "#/$defs/RegionProposalAction"
    },
    "region_id": {
      "pattern": "^reg_[0-9a-f]{32}$",
      "title": "Region Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "secondary_source_memberships": {
      "default": [],
      "items": {
        "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Secondary Source Memberships",
      "type": "array"
    },
    "split_certificate_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "split_proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/SplitProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/RegionPlanStatus"
    },
    "stop_proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/StopProposal"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "theme_definition": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Theme Definition",
      "type": "string"
    },
    "theme_label": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Theme Label",
      "type": "string"
    },
    "unresolved_source_ids": {
      "default": [],
      "items": {
        "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Unresolved Source Ids",
      "type": "array"
    }
  },
  "required": [
    "region_id",
    "plan_version",
    "theme_label",
    "theme_definition",
    "primary_source_memberships",
    "proposed_action",
    "evidence_refs",
    "planner_attempt",
    "planner",
    "status"
  ],
  "title": "RegionPlan",
  "type": "object"
}
