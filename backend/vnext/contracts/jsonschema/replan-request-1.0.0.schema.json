{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "BoundaryError": {
      "additionalProperties": false,
      "properties": {
        "current_region_id": {
          "pattern": "^reg_[0-9a-f]{32}$",
          "title": "Current Region Id",
          "type": "string"
        },
        "expected_region_id": {
          "anyOf": [
            {
              "pattern": "^reg_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Region Id"
        },
        "reason": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "source_id": {
          "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "current_region_id",
        "reason"
      ],
      "title": "BoundaryError",
      "type": "object"
    },
    "DuplicateMembership": {
      "additionalProperties": false,
      "properties": {
        "region_ids": {
          "items": {
            "pattern": "^reg_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Region Ids",
          "type": "array"
        },
        "source_id": {
          "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "region_ids"
      ],
      "title": "DuplicateMembership",
      "type": "object"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "InvalidParentRelation": {
      "additionalProperties": false,
      "properties": {
        "child_region_id": {
          "pattern": "^reg_[0-9a-f]{32}$",
          "title": "Child Region Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "parent_region_id": {
          "pattern": "^reg_[0-9a-f]{32}$",
          "title": "Parent Region Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "parent_region_id",
        "child_region_id",
        "evidence_refs",
        "reason"
      ],
      "title": "InvalidParentRelation",
      "type": "object"
    },
    "ReplanAction": {
      "enum": [
        "RESPLIT",
        "MERGE_SIBLINGS",
        "MOVE_BOUNDARY",
        "RENAME_REGION",
        "MARK_UNRESOLVED"
      ],
      "title": "ReplanAction",
      "type": "string"
    },
    "ReplanStatus": {
      "enum": [
        "open",
        "accepted",
        "rejected",
        "resolved",
        "superseded"
      ],
      "title": "ReplanStatus",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:replan-request:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_region_id": {
      "pattern": "^reg_[0-9a-f]{32}$",
      "title": "Affected Region Id",
      "type": "string"
    },
    "boundary_errors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BoundaryError"
      },
      "title": "Boundary Errors",
      "type": "array"
    },
    "duplicate_memberships": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DuplicateMembership"
      },
      "title": "Duplicate Memberships",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "invalid_parent_relations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InvalidParentRelation"
      },
      "title": "Invalid Parent Relations",
      "type": "array"
    },
    "minimum_replan_ancestor_id": {
      "pattern": "^reg_[0-9a-f]{32}$",
      "title": "Minimum Replan Ancestor Id",
      "type": "string"
    },
    "mixed_theme_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Mixed Theme Evidence",
      "type": "array"
    },
    "omitted_source_ids": {
      "default": [],
      "items": {
        "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Omitted Source Ids",
      "type": "array"
    },
    "request_id": {
      "pattern": "^replan_[0-9a-f]{32}$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_action": {
      "$ref": "#/$defs/ReplanAction"
    },
    "requester": {
      "const": "bottom_up_region_auditor",
      "default": "bottom_up_region_auditor",
      "title": "Requester",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReplanStatus",
      "default": "open"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "request_id",
    "affected_region_id",
    "minimum_replan_ancestor_id",
    "requested_action",
    "evidence_refs"
  ],
  "title": "ReplanRequest",
  "type": "object"
}
