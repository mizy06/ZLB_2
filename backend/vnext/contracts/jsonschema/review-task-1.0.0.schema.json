{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ReviewAction": {
      "enum": [
        "confirm_current",
        "change_parent",
        "no_suitable_parent",
        "reject_concept",
        "rename_concept",
        "merge_concepts",
        "split_concept",
        "recrop_visual",
        "confirm_root",
        "request_region_replan",
        "accept_cross_link",
        "reject_cross_link",
        "apply_source_correction"
      ],
      "title": "ReviewAction",
      "type": "string"
    },
    "ReviewKind": {
      "enum": [
        "root",
        "region_structure",
        "parent_competition",
        "cross_branch",
        "label_granularity",
        "merge_split",
        "visual",
        "cross_link",
        "omission",
        "source_correction"
      ],
      "title": "ReviewKind",
      "type": "string"
    },
    "ReviewOption": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/ReviewAction"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "option_id": {
          "pattern": "^review_option_[0-9a-f]{32}$",
          "title": "Option Id",
          "type": "string"
        },
        "target_ids": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Ids",
          "type": "array"
        }
      },
      "required": [
        "option_id",
        "action",
        "label"
      ],
      "title": "ReviewOption",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "pending",
        "resolved",
        "superseded",
        "cancelled"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:review-task:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_artifact_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "maxItems": 2,
      "title": "Evidence Refs",
      "type": "array"
    },
    "minimum_replan_region_id": {
      "anyOf": [
        {
          "pattern": "^reg_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Replan Region Id"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/ReviewOption"
      },
      "maxItems": 3,
      "minItems": 2,
      "title": "Options",
      "type": "array"
    },
    "owner_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Owner Id",
      "type": "string"
    },
    "question": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "resolution_decision_id": {
      "anyOf": [
        {
          "pattern": "^review_decision_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution Decision Id"
    },
    "review_id": {
      "pattern": "^review_[0-9a-f]{32}$",
      "title": "Review Id",
      "type": "string"
    },
    "review_kind": {
      "$ref": "#/$defs/ReviewKind"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReviewStatus",
      "default": "pending"
    },
    "subject_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Subject Ids",
      "type": "array"
    },
    "supersedes_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Revision"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "owner_id",
    "run_id",
    "revision",
    "review_kind",
    "question",
    "subject_ids",
    "options",
    "base_artifact_ref",
    "created_at",
    "updated_at"
  ],
  "title": "ReviewTask",
  "type": "object"
}
