{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "relation_proposal_ledger",
        "relation_assessment_ledger",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "ExpansionState": {
      "additionalProperties": false,
      "properties": {
        "expanded": {
          "title": "Expanded",
          "type": "boolean"
        },
        "node_id": {
          "anyOf": [
            {
              "pattern": "^concept_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "pattern": "^view:[a-z0-9][a-z0-9._:-]{1,127}$",
              "type": "string"
            }
          ],
          "title": "Node Id"
        }
      },
      "required": [
        "node_id",
        "expanded"
      ],
      "title": "ExpansionState",
      "type": "object"
    },
    "LayoutProfile": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "source_order_single_side",
            "outline",
            "paged"
          ],
          "title": "Direction",
          "type": "string"
        },
        "medium": {
          "enum": [
            "web",
            "mobile",
            "png",
            "pdf",
            "json"
          ],
          "title": "Medium",
          "type": "string"
        },
        "node_budget": {
          "minimum": 1,
          "title": "Node Budget",
          "type": "integer"
        },
        "parameters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StringValue"
          },
          "title": "Parameters",
          "type": "array"
        },
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "medium",
        "direction",
        "node_budget"
      ],
      "title": "LayoutProfile",
      "type": "object"
    },
    "OverlayMode": {
      "enum": [
        "source_only",
        "grounded_assist",
        "enriched_overlay"
      ],
      "title": "OverlayMode",
      "type": "string"
    },
    "OverlayState": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "external_node_ids": {
          "default": [],
          "items": {
            "pattern": "^ext:[a-z0-9][A-Za-z0-9._:/-]{1,255}$",
            "type": "string"
          },
          "title": "External Node Ids",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/OverlayMode",
          "default": "source_only"
        }
      },
      "title": "OverlayState",
      "type": "object"
    },
    "ProjectionAggregation": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "member_concept_ids": {
          "items": {
            "pattern": "^concept_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Member Concept Ids",
          "type": "array"
        },
        "view_node_id": {
          "pattern": "^view:[a-z0-9][a-z0-9._:-]{1,127}$",
          "title": "View Node Id",
          "type": "string"
        }
      },
      "required": [
        "view_node_id",
        "label",
        "member_concept_ids"
      ],
      "title": "ProjectionAggregation",
      "type": "object"
    },
    "ProjectionDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "affected_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Affected Ids",
          "type": "array"
        },
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "ProjectionDiagnostic",
      "type": "object"
    },
    "ProjectionParentSelection": {
      "additionalProperties": false,
      "properties": {
        "alternate_parent_edge_ids": {
          "default": [],
          "items": {
            "pattern": "^relation_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Alternate Parent Edge Ids",
          "type": "array"
        },
        "child_concept_id": {
          "pattern": "^concept_[0-9a-f]{32}$",
          "title": "Child Concept Id",
          "type": "string"
        },
        "policy_version": {
          "default": "view-parent-policy-v1",
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "selected_parent_edge_id": {
          "pattern": "^relation_[0-9a-f]{32}$",
          "title": "Selected Parent Edge Id",
          "type": "string"
        },
        "selection_reason": {
          "default": "stable_semantic_priority",
          "maxLength": 256,
          "minLength": 1,
          "title": "Selection Reason",
          "type": "string"
        },
        "suppressed_canonical_edge_ids": {
          "default": [],
          "items": {
            "pattern": "^relation_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Suppressed Canonical Edge Ids",
          "type": "array"
        }
      },
      "required": [
        "child_concept_id",
        "selected_parent_edge_id"
      ],
      "title": "ProjectionParentSelection",
      "type": "object"
    },
    "ProjectionPurpose": {
      "enum": [
        "overview",
        "section_focus",
        "search",
        "review",
        "export",
        "diagnostic"
      ],
      "title": "ProjectionPurpose",
      "type": "string"
    },
    "ProjectionQualityStatus": {
      "enum": [
        "unassessed",
        "blocked_document",
        "blocked_claim",
        "blocked_semantic",
        "blocked_evidence",
        "review_required",
        "passed"
      ],
      "title": "ProjectionQualityStatus",
      "type": "string"
    },
    "StringValue": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "value": {
          "maxLength": 4096,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "title": "StringValue",
      "type": "object"
    },
    "ViewContainsEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "pattern": "^view_edge_[0-9a-f]{32}$",
          "title": "Edge Id",
          "type": "string"
        },
        "source_view_id": {
          "pattern": "^view:[a-z0-9][a-z0-9._:-]{1,127}$",
          "title": "Source View Id",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "pattern": "^concept_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "pattern": "^view:[a-z0-9][a-z0-9._:-]{1,127}$",
              "type": "string"
            }
          ],
          "title": "Target Id"
        }
      },
      "required": [
        "edge_id",
        "source_view_id",
        "target_id"
      ],
      "title": "ViewContainsEdge",
      "type": "object"
    }
  },
  "$id": "urn:zlb:vnext:schema:diagnostic-projection:0.1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregation_map": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProjectionAggregation"
      },
      "title": "Aggregation Map",
      "type": "array"
    },
    "alternate_parent_edge_ids": {
      "default": [],
      "items": {
        "pattern": "^relation_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Alternate Parent Edge Ids",
      "type": "array"
    },
    "canonical_graph_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "canonical_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Canonical Hash",
      "type": "string"
    },
    "diagnostics": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProjectionDiagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "expansion_state": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExpansionState"
      },
      "title": "Expansion State",
      "type": "array"
    },
    "filters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StringValue"
      },
      "title": "Filters",
      "type": "array"
    },
    "hidden_ids": {
      "default": [],
      "items": {
        "pattern": "^concept_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Hidden Ids",
      "type": "array"
    },
    "included_ids": {
      "items": {
        "anyOf": [
          {
            "pattern": "^concept_[0-9a-f]{32}$",
            "type": "string"
          },
          {
            "pattern": "^view:[a-z0-9][a-z0-9._:-]{1,127}$",
            "type": "string"
          }
        ]
      },
      "title": "Included Ids",
      "type": "array"
    },
    "layout_profile": {
      "$ref": "#/$defs/LayoutProfile"
    },
    "overlay_state": {
      "$ref": "#/$defs/OverlayState",
      "default": {
        "enabled": false,
        "external_node_ids": [],
        "mode": "source_only"
      }
    },
    "parent_selections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProjectionParentSelection"
      },
      "title": "Parent Selections",
      "type": "array"
    },
    "projection_hash": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projection Hash"
    },
    "projection_id": {
      "pattern": "^projection_[0-9a-f]{32}$",
      "title": "Projection Id",
      "type": "string"
    },
    "projection_parent_edge_ids": {
      "default": [],
      "items": {
        "pattern": "^relation_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Projection Parent Edge Ids",
      "type": "array"
    },
    "purpose": {
      "$ref": "#/$defs/ProjectionPurpose"
    },
    "quality_status": {
      "$ref": "#/$defs/ProjectionQualityStatus"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "suppressed_canonical_edge_ids": {
      "default": [],
      "items": {
        "pattern": "^relation_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Suppressed Canonical Edge Ids",
      "type": "array"
    },
    "view_contains_edges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ViewContainsEdge"
      },
      "title": "View Contains Edges",
      "type": "array"
    }
  },
  "required": [
    "projection_id",
    "canonical_graph_ref",
    "canonical_hash",
    "purpose",
    "included_ids",
    "layout_profile",
    "quality_status"
  ],
  "title": "DiagnosticProjection",
  "type": "object"
}
