{
  "$defs": {
    "CanaryDecision": {
      "enum": [
        "hold",
        "advance",
        "rollback"
      ],
      "title": "CanaryDecision",
      "type": "string"
    },
    "CanaryStage": {
      "enum": [
        "shadow",
        "allowlist",
        "percent_1",
        "percent_5",
        "percent_20",
        "percent_50",
        "default"
      ],
      "title": "CanaryStage",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:canary-transition-decision:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/CanaryDecision"
    },
    "decision_id": {
      "pattern": "^canary_decision_[0-9a-f]{32}$",
      "title": "Decision Id",
      "type": "string"
    },
    "evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Evidence Digest",
      "type": "string"
    },
    "from_stage": {
      "$ref": "#/$defs/CanaryStage"
    },
    "observation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Observation Digest",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "release_id": {
      "pattern": "^release_[0-9a-f]{32}$",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "to_stage": {
      "$ref": "#/$defs/CanaryStage"
    }
  },
  "required": [
    "decision_id",
    "release_id",
    "from_stage",
    "to_stage",
    "decision",
    "policy_digest",
    "evidence_digest",
    "observation_digest",
    "reason_codes",
    "decided_at"
  ],
  "title": "CanaryTransitionDecision",
  "type": "object"
}
