{
  "$defs": {
    "ModelSlot": {
      "additionalProperties": false,
      "properties": {
        "calibration_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Score"
        },
        "context_limit": {
          "minimum": 1,
          "title": "Context Limit",
          "type": "integer"
        },
        "independence_calibrated": {
          "default": false,
          "title": "Independence Calibrated",
          "type": "boolean"
        },
        "independence_group": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Independence Group"
        },
        "model_family": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model Family",
          "type": "string"
        },
        "model_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Revision",
          "type": "string"
        },
        "price_input_microunits_per_million": {
          "minimum": 0,
          "title": "Price Input Microunits Per Million",
          "type": "integer"
        },
        "price_output_microunits_per_million": {
          "minimum": 0,
          "title": "Price Output Microunits Per Million",
          "type": "integer"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "region": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Region",
          "type": "string"
        },
        "slot": {
          "enum": [
            "vlm_reader",
            "claim_extractor",
            "global_structure_planner",
            "recursive_region_planner",
            "region_decision_verifier",
            "verifier_a",
            "verifier_b",
            "arbiter",
            "tool_researcher"
          ],
          "title": "Slot",
          "type": "string"
        },
        "structured_output": {
          "title": "Structured Output",
          "type": "boolean"
        }
      },
      "required": [
        "slot",
        "provider",
        "model_revision",
        "model_family",
        "context_limit",
        "structured_output",
        "region",
        "price_input_microunits_per_million",
        "price_output_microunits_per_million"
      ],
      "title": "ModelSlot",
      "type": "object"
    }
  },
  "$id": "urn:zlb:vnext:schema:model-portfolio-manifest:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slots": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelSlot"
      },
      "title": "Slots",
      "type": "array"
    }
  },
  "title": "ModelPortfolioManifest",
  "type": "object"
}
