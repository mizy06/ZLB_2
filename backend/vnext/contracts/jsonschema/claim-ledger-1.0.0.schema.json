{
  "$defs": {
    "ArtifactProducerRef": {
      "additionalProperties": false,
      "properties": {
        "model_revision": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "producer_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "producer_version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Producer Version",
          "type": "string"
        },
        "prompt_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Digest"
        },
        "role": {
          "$ref": "#/$defs/RuntimeRole"
        }
      },
      "required": [
        "producer_id",
        "producer_version",
        "role"
      ],
      "title": "ArtifactProducerRef",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "owner_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "payload_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "artifact_id",
        "artifact_type",
        "payload_digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "source_observation_ir",
        "source_inventory",
        "region_plan",
        "region_split_certificate",
        "replan_request",
        "claim_ledger",
        "omission_audit",
        "canonical_explicit_graph",
        "diagnostic_projection"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "ClaimNovelty": {
      "enum": [
        "source_explicit",
        "source_restatement",
        "planner_context",
        "external_extension"
      ],
      "title": "ClaimNovelty",
      "type": "string"
    },
    "ClaimPublicationStatus": {
      "enum": [
        "candidate",
        "core",
        "enriched_overlay",
        "withheld",
        "needs_review",
        "rejected"
      ],
      "title": "ClaimPublicationStatus",
      "type": "string"
    },
    "ClaimQualifier": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "source_evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Source Evidence Refs",
          "type": "array"
        },
        "value": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "source_evidence_refs"
      ],
      "title": "ClaimQualifier",
      "type": "object"
    },
    "ClaimRecord": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^claim_[0-9a-f]{32}$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "decision_history": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DecisionEvent"
          },
          "title": "Decision History",
          "type": "array"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "pattern": "^claim_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "external_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "External Evidence Refs",
          "type": "array"
        },
        "external_resolver": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactProducerRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "external_validity_status": {
          "$ref": "#/$defs/ExternalValidityStatus"
        },
        "extraction_confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Extraction Confidence",
          "type": "number"
        },
        "extraction_status": {
          "$ref": "#/$defs/ExtractionStatus"
        },
        "extractor": {
          "$ref": "#/$defs/ArtifactProducerRef"
        },
        "fidelity_verifier": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactProducerRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "instructional_role": {
          "$ref": "#/$defs/InstructionalRole"
        },
        "leaf_region_id": {
          "pattern": "^reg_[0-9a-f]{32}$",
          "title": "Leaf Region Id",
          "type": "string"
        },
        "normalized_text": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Normalized Text",
          "type": "string"
        },
        "novelty": {
          "$ref": "#/$defs/ClaimNovelty"
        },
        "object_mentions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Mention"
          },
          "title": "Object Mentions",
          "type": "array"
        },
        "predicate": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "publication_status": {
          "$ref": "#/$defs/ClaimPublicationStatus"
        },
        "qualifiers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClaimQualifier"
          },
          "title": "Qualifiers",
          "type": "array"
        },
        "review_of": {
          "default": [],
          "items": {
            "pattern": "^claim_[0-9a-f]{32}$",
            "type": "string"
          },
          "title": "Review Of",
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/ClaimScope"
        },
        "source_entailment_status": {
          "$ref": "#/$defs/SourceEntailmentStatus"
        },
        "source_evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Source Evidence Refs",
          "type": "array"
        },
        "source_text": {
          "title": "Source Text",
          "type": "string"
        },
        "subject_mentions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Mention"
          },
          "title": "Subject Mentions",
          "type": "array"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^claim_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        }
      },
      "required": [
        "claim_id",
        "leaf_region_id",
        "claim_type",
        "normalized_text",
        "source_text",
        "predicate",
        "instructional_role",
        "novelty",
        "scope",
        "source_evidence_refs",
        "extraction_confidence",
        "extraction_status",
        "source_entailment_status",
        "external_validity_status",
        "publication_status",
        "extractor"
      ],
      "title": "ClaimRecord",
      "type": "object"
    },
    "ClaimScope": {
      "enum": [
        "object",
        "page",
        "region",
        "document"
      ],
      "title": "ClaimScope",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "definition",
        "property",
        "mechanism",
        "reaction",
        "condition",
        "comparison",
        "example",
        "exception",
        "procedure",
        "warning",
        "summary",
        "instruction",
        "structural_fact"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "DecisionEvent": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeRole"
            },
            {
              "pattern": "^human:[A-Za-z0-9._:@-]{1,128}$",
              "type": "string"
            }
          ],
          "title": "Actor"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Decision",
          "type": "string"
        },
        "decision_id": {
          "pattern": "^decision_[0-9a-f]{32}$",
          "title": "Decision Id",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "supersedes": {
          "anyOf": [
            {
              "pattern": "^decision_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        }
      },
      "required": [
        "decision_id",
        "actor",
        "decision",
        "created_at"
      ],
      "title": "DecisionEvent",
      "type": "object"
    },
    "EvidenceNamespace": {
      "enum": [
        "courseware",
        "external",
        "human",
        "system"
      ],
      "title": "EvidenceNamespace",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "courseware"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "external"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9._:/-]{1,251}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "human"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^human:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,249}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "namespace": {
                "const": "system"
              }
            },
            "required": [
              "namespace"
            ]
          },
          "then": {
            "properties": {
              "ref_id": {
                "pattern": "^sys:[A-Za-z0-9][A-Za-z0-9._:@/-]{1,251}$"
              }
            }
          }
        }
      ],
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "namespace": {
          "$ref": "#/$defs/EvidenceNamespace"
        },
        "ref_id": {
          "maxLength": 256,
          "minLength": 6,
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExternalValidityStatus": {
      "enum": [
        "not_checked",
        "supports",
        "contradicts",
        "disambiguates",
        "normalizes",
        "extends",
        "unresolved"
      ],
      "title": "ExternalValidityStatus",
      "type": "string"
    },
    "ExtractionStatus": {
      "enum": [
        "candidate",
        "extracted",
        "partial",
        "unresolved",
        "rejected"
      ],
      "title": "ExtractionStatus",
      "type": "string"
    },
    "InstructionalRole": {
      "enum": [
        "definition",
        "principle",
        "procedure",
        "comparison",
        "application",
        "exercise",
        "review",
        "example",
        "warning",
        "other"
      ],
      "title": "InstructionalRole",
      "type": "string"
    },
    "Mention": {
      "additionalProperties": false,
      "properties": {
        "normalized_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Name"
        },
        "source_ids": {
          "items": {
            "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "source_ids"
      ],
      "title": "Mention",
      "type": "object"
    },
    "RuntimeRole": {
      "enum": [
        "run_governor",
        "document_interpreter",
        "source_inventory_auditor",
        "global_structure_planner",
        "recursive_region_planner",
        "region_decision_verifier",
        "claim_atomizer",
        "omission_auditor",
        "bottom_up_region_auditor",
        "claim_fidelity_verifier",
        "domain_resolver",
        "canonicalizer",
        "relation_verifier_a",
        "relation_verifier_b",
        "arbiter",
        "quality_auditor",
        "projection_planner"
      ],
      "title": "RuntimeRole",
      "type": "string"
    },
    "SourceEntailmentStatus": {
      "enum": [
        "unassessed",
        "entailed",
        "partial",
        "contradicted",
        "insufficient"
      ],
      "title": "SourceEntailmentStatus",
      "type": "string"
    }
  },
  "$id": "urn:zlb:vnext:schema:claim-ledger:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/ClaimRecord"
      },
      "title": "Claims",
      "type": "array"
    },
    "document_ir_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "ledger_id": {
      "pattern": "^ledger_[0-9a-f]{32}$",
      "title": "Ledger Id",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/ArtifactProducerRef"
    },
    "recorded_interaction_ids": {
      "default": [],
      "items": {
        "pattern": "^interaction_[0-9a-f]{32}$",
        "type": "string"
      },
      "title": "Recorded Interaction Ids",
      "type": "array"
    },
    "region_plan_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Region Plan Refs",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unresolved_source_ids": {
      "default": [],
      "items": {
        "pattern": "^src:[a-z][a-z0-9_-]{1,31}:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Unresolved Source Ids",
      "type": "array"
    }
  },
  "required": [
    "ledger_id",
    "document_ir_ref",
    "region_plan_refs",
    "claims",
    "producer"
  ],
  "title": "ClaimLedger",
  "type": "object"
}
